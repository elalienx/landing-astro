---
// Components
import Hero from "@components/Hero"
import ConsumerForm from "@forms/ConsumerForm";
import IncrementalCounter from '@components/IncrementalCounter';
import Kreddy from "@components/Kreddy"
import Partners from "@components/Partners";

// Layouts
import Layout from '@layouts/Layout.astro';
---

<Layout>
	<Hero product="Consumer loans">
		<ConsumerForm client:load />
	</Hero>
	<Partners client:visible/>
	<Kreddy />
	<IncrementalCounter client:visible label='How many videogames have you purchased this year?'/>
</Layout>

