---
// Components
import Navigation from "../components/Navigation"

// Styles
import "@styles/style.css"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href="/fonts/circular-pro-bold-subset.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/circular-pro-book-subset.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Landing</title>
	</head>
	<body>
		<Navigation currentPath={Astro.url.pathname}/>
		<slot />
	</body>
</html>
